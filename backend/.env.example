# Optional Gemini key; regex extraction is used when unset.
GEMINI_API_KEY=your-gemini-api-key
# Gemini model name used if Gemini integration is enabled.
GEMINI_MODEL=gemini-2.5-flash
# Keep simulated TinyFish lookups enabled unless real integration is configured.
USE_MOCKS=true
# TinyFish key; required only when USE_MOCKS=false.
TINYFISH_API_KEY=your-tinyfish-api-key
# Comma-separated browser origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional regex for deployment preview origins, for example Vercel previews.
ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+\.vercel\.app$
# Render sets PORT automatically; use this default for local runs.
PORT=8000